# Hébergement LWS (Apache) — site statique DAVYCAS International (généré par scripts/build.mjs)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS et adresse sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://davycas.com%{REQUEST_URI} [L,R=301]

# Anciennes adresses du site (version 2025-2026) vers la nouvelle arborescence
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^about\.html$ /qui-sommes-nous/ [L,R=301]
RewriteRule ^piliers\.html$ /nos-actions/ [L,R=301]
RewriteRule ^projets\.html$ /nos-actions/ [L,R=301]
RewriteRule ^stelab\.html$ /nos-actions/stelab/ [L,R=301]
RewriteRule ^siteb\.html$ /nos-actions/siteb/ [L,R=301]
RewriteRule ^contact\.html$ /contact/ [L,R=301]
RewriteRule ^interventions-surveillance-epidemiologique\.html$ /nos-actions/#surveillance [L,R=301,NE]
RewriteRule ^interventions-laboratoire\.html$ /nos-actions/#laboratoire [L,R=301,NE]
RewriteRule ^interventions-systeme-information\.html$ /nos-actions/#systemes-information [L,R=301,NE]
RewriteRule ^interventions-etudes-formations\.html$ /nos-actions/#etudes [L,R=301,NE]
RewriteRule ^interventions-oeuvres-sociales\.html$ /nos-actions/#oeuvres-sociales [L,R=301,NE]

# Anciennes adresses WordPress
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed)(/.*)?$ - [G,L]
</IfModule>

# Fichiers internes jamais servis
<FilesMatch "\.(py|md|json|lock|mjs)$|^\.">
    Require all denied
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-REPLACE_INLINE_HASH'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# Cache : les ressources versionnées longtemps, le HTML toujours revalidé
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType image/avif .avif
AddType font/woff2 .woff2
