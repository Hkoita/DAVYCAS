# Hébergement LWS (Apache) — site statique bilingue DAVYCAS International (généré par scripts/build.mjs)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS et adresse sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://davycas.com%{REQUEST_URI} [L,R=301]

# /index.html -> / (seulement si demandé explicitement : évite la boucle avec DirectoryIndex)
RewriteCond %{THE_REQUEST} \s/+(en/)?index\.html[\s?] [NC]
RewriteRule ^(en/)?index\.html$ /$1 [L,R=301]

# Anciennes adresses WordPress
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed)(/.*)?$ - [G,L]
</IfModule>

# Fichiers internes jamais servis
<FilesMatch "\.(py|md|json|lock|mjs)$|^\.">
    Require all denied
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' REPLACE_INLINE_HASHES; font-src 'self'; frame-src https://www.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# Cache : CSS et JS versionnés (?v=) gardés longtemps, HTML toujours revalidé
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType image/avif .avif
AddType font/woff2 .woff2
